# Copy to .env (never commit the .env file)

# Key for the "Live · Claude" engine. Without a key the app uses the offline engine.
ANTHROPIC_API_KEY=

# live | offline (empty = live if a key is set, otherwise offline)
TEACHBACK_MODE=

# Models (defaults are already set in the code)
TEACHBACK_TEACHER_MODEL=claude-opus-5-5
TEACHBACK_SUBSTUDENT_MODEL=claude-haiku-5-5

# Budget of model calls per session, then hand over to a human
TEACHBACK_MAX_CALLS=60
