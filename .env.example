# Copiare in .env (il file .env non va mai committato)

# Chiave per il motore "Live · Claude". Senza chiave l'app usa il copione offline.
ANTHROPIC_API_KEY=

# live | offline (vuoto = live se c'è la chiave, altrimenti offline)
TEACHBACK_MODE=

# Modelli (default già impostati nel codice)
TEACHBACK_TEACHER_MODEL=claude-opus-5-5
TEACHBACK_SUBSTUDENT_MODEL=claude-haiku-5-5

# Budget di chiamate al modello per sessione, poi si passa a un umano
TEACHBACK_MAX_CALLS=60
